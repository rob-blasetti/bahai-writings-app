# Copy this file to .env and fill in values.
#
# NOTE: .env is gitignored by design.

# Development API base URL (used by config.js as API_URL)
DEV_API=

# Auth gateway base URL or full login endpoint
AUTH_API_URL=https://liquid-spirit-auth.vercel.app

# Optional: AWS credentials (only if you actually use them)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
